    - "// @input SceneObject cameraObject {\"hint\":\"Main camera (the user's eyes)\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input bool placeStationAtCamera = true {\"hint\":\"Place the station relative to where the user's eyes are when the Lens starts\"}"
    - '// @input bool facePanelsToUser = true {"hint":"Turn the start menu, step card and control bar to face the user at start"}'
    - "// @input float backMappedHoldSec = 1.2 {\"hint\":\"Seconds 'Back mapped' stays before the first step begins\", \"widget\":\"slider\", \"min\":0.2, \"max\":4, \"step\":0.1}"
    - '// @input float introHintSec = 5 {"hint":"Seconds at the start of a session during which the edge hint points to the controls", "widget":"slider", "min":0, "max":15, "step":0.5}'
    - "// @input float barInViewDegrees = 20 {\"hint\":\"The control bar counts as 'in view' within this angle from the view centre (degrees)\", \"widget\":\"slider\", \"min\":10, \"max\":40, \"step\":1}"
    - '// @input float strokeLiftCm = 0.5 {"hint":"Height of the strokes above the skin, cm", "widget":"slider", "min":0.1, "max":3, "step":0.1}'
