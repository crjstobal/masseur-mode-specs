  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">MasseurMain - Masseur Mode orchestrator</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 sessionManager {"hint":"Session state owner"}'
    - '// @input AssignableType_2 startMenu {"hint":"Start menu above the upper back"}'
